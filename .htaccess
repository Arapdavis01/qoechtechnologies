# ============================================================
# QOECH TECHNOLOGIES — Apache / cPanel settings
# Upload this file to the same folder as index.html.
# Needs mod_headers and mod_rewrite (standard on cPanel hosts).
# ============================================================

Options -Indexes
ServerSignature Off
ErrorDocument 404 /404.html
DirectoryIndex index.html

# ---------- Correct file types (ES modules need a JavaScript type) ----------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- Force HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Hide dotfiles (except /.well-known/), tooling and source/backup files
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(tools|node_modules)(/|$) - [F,L]
  RewriteRule \.(md|mjs|lock|log|sh|py|bak|old|orig|sql|env|ini|conf)$ - [F,L]
  RewriteRule ^(package|package-lock|vercel)\.json$ - [F,L]
  RewriteRule ^_headers$ - [F,L]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://eaglevision-api.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By

  # ---------- Caching ----------
  # HTML is always re-checked so updates show immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS/JS are re-checked hourly (file names are not versioned).
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
